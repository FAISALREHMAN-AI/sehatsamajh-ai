# SehatSamajh Backend Environment Configuration

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: a current Gemini Flash model, e.g. gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend server host and port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list of frontend domains, default: http://localhost:5173,http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
